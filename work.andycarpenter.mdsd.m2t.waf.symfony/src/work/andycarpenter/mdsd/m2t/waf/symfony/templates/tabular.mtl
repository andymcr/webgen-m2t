[comment encoding = UTF-8 /]
[module tabular(
	'http://andycarpenter.work/metamodel/WebApplicationFramework')]
[import work::andycarpenter::mdsd::m2t::waf::core::uriRoutes/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::controller/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::files/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::interface/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::names/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::translation/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::units/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::expression::authorisationTemplate/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::expression::twig/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::templates::accessor/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::templates::action/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::templates::base/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::templates::fields/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::templates::titles/]
[import work::andycarpenter::mdsd::m2t::waf::symfony::templates::value/]


[template public unitView(unit : ContentUnit)
	? (unit.oclIsKindOf(TabularUnit)) post(trim())]
[let tabularUnit : TabularUnit = unit.oclAsType(TabularUnit)]
[let accessor : String = tabularUnit.instanceParameter()]
[file(tabularUnit.templateFilename(), false)]
[if (unit.controller.isMultiPage())]
[unit.templateStart()/]

{% block content %}
[/if]
{% trans_default_domain "entity" %}
<section [if (tabularUnit.hasSectionClass())] class="[tabularUnit.sectionClass()/]" [/if]id="[tabularUnit.instanceParameter()/]">
 <h4[if (tabularUnit.hasCaptionClass() or tabularUnit.omitCaption)]
 class="[if (tabularUnit.hasCaptionClass())][tabularUnit.captionClass()/][/if] [if (tabularUnit.omitCaption)] hidden[/if]"[/if]>[tabularUnit.unitTitle()/]</h4>
 <twig:[tabularUnit.twigTemplatesNamespace()/][tabularUnit.componentClassName()/][if (tabularUnit.hasSelectPath())]
  [tabularUnit.selection.selectionType().instanceName()/]="{{ [tabularUnit.containerParameter()/] }}"[/if][if (tabularUnit.oclIsKindOf(CollectionUnit) and tabularUnit.selection.hasFormals())]
[if (tabularUnit.isContained())]
  [tabularUnit.contentType.containingType.instanceName()/]="{{ [tabularUnit.containerParameter()/] }}"[/if][/if]/>
</section>
[if (unit.controller.isMultiPage())]
{% endblock %}
[/if]
[/file]
[/let]
[/let]
[/template]

[template public unitContent(unit : ContentUnit)
	?(unit.oclIsKindOf(TabularUnit)) post(trim())]
[let tabularUnit : TabularUnit = unit.oclAsType(TabularUnit)]
[let accessor : String = tabularUnit.contentType.pluralisedName.toLowerFirst()]
[let variable : String = tabularUnit.contentType.instanceName()]
<table class="[tabularUnit.contentClass()/]">
[if (not tabularUnit.hasOmittedFieldLabels())]
 <thead[if (tabularUnit.hasHeaderClass())] class="[tabularUnit.headerClass()/]"[/if]>
  <tr>
 	[for (field : UnitField | tabularUnit.displayFields)]
		[if (field.isAuthorised)]
{% if [field.authorisation.authorisationExpression()/] %}
		[/if]
   <th>[if (field.hasCustomisedDisplayLabel)]
{{ '[field.customisedCaptionContainedId()/]' | trans({}, '[tabularUnit.translationDomain()/]') }}[else]
{{ '[field.oclAsType(UnitFeature).defaultDisplayLabelContainedId()/]' | trans }}[/if]</th>
		[if (field.isAuthorised)]
{% endif %}
		[/if]
 	[/for]
	[if (tabularUnit.hasInstanceActions())]
   <th>Actions</th>
	[/if]
  </tr>
 </thead>
[/if]
 <tbody>
{% for [variable/] in [if (not tabularUnit.hasPagination())]this.[/if][accessor/] %}
  <tr class="{{ cycle(['['/][for (class : String | tabularUnit.rowClasses().trim().tokenize(',; ')) separator (', ')]'[class/]'[/for][']'/], loop.index0) }}">
   [tabularUnit.entry(variable)/]
[if (tabularUnit.hasInstanceActions())]
   <td class="actions">[tabularUnit.instanceActions(variable)/]</td>
[/if]
  </tr>
[if (tabularUnit.emptyMessage.trim() <> '')]
{% else %}
  <tr>
   <td[if (tabularUnit.displayFields->size() > 1)] colspan="[tabularUnit.displayFields->size()/]"[/if]>[tabularUnit.emptyMessage/]</td>
	[if (tabularUnit.hasInstanceActions())]
   <td class="actions">&nbsp;</td>
	[/if]
  </tr>
[/if]
{% endfor %}
 </tbody>
[if (tabularUnit.hasContainerActions() and tabularUnit.isContained())]
 <tfoot>
  <tr>
   [tabularUnit.containerActions(tabularUnit.containerParameter())/]
  </tr>
 </tfoot>
[/if]
</table>
[/let]
[/let]
[/let]
[/template]

[template private entry(unit : TabularUnit, accessor : String) post(trim())]
[for (field : UnitField | unit.displayFields)]
	[if (field.isAuthorised)]
{% if [field.authorisation.authorisationExpression()/] %}
	[/if]
<td[if (field.isFeatureField())] class="[field.oclAsType(UnitFeature).leafFeature().name.replaceAll('([A-Z])', '_$1').toLower()/]"[/if]>[field.displayField(accessor)/]</td>
	[if (field.isAuthorised)]
{% endif %}
	[/if]
[/for]
[/template]

[template private instanceActions(unit : TabularUnit, rowAccessor : String) post(trim())]
[for (action : Action | unit.instanceActions())]
[action.unitActionLink(rowAccessor)/]
[/for]
[/template]

[template private containerActions(unit : TabularUnit, accessor : String) post(trim())]
[for (action : Action | unit.containerActions())]
[action.unitActionLink(accessor)/]
[/for]
[/template]
